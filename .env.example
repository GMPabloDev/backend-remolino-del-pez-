# Base de datos
DATABASE_URL=postgresql://user:password@host:port/dbname

# Admin inicial (seed)
ADMIN_NAME=Administrador
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=una-contraseña-segura

# Autenticación
ACCESS_TOKEN_SECRET=cambiar-por-un-secreto-largo-de-al-menos-32-caracteres
ACCESS_TOKEN_TTL_MINUTES=25
REFRESH_TOKEN_TTL_DAYS=30

# Checkout y pagos
CHECKOUT_TOKEN_SECRET=cambiar-por-un-secreto-largo-de-al-menos-32-caracteres
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_CHECKOUT_SUCCESS_URL=http://localhost:4321/payment-result?result=success
STRIPE_CHECKOUT_CANCEL_URL=http://localhost:4321/payment-result?result=cancel

# Cuentas de cliente y magic links
CUSTOMER_ACCESS_TOKEN_SECRET=cambiar-por-otro-secreto-largo-de-al-menos-32-caracteres
CUSTOMER_MAGIC_LINK_URL=http://localhost:4321/auth/magic-link

# Correo SMTP (Gmail requiere una contraseña de aplicación)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=correo@example.com
SMTP_PASS=contraseña-de-aplicación
SMTP_FROM_NAME=Restaurante Olímpico
SMTP_FROM_EMAIL=correo@example.com
EMAIL_LOGO_URL=https://res.cloudinary.com/tu-cloud/image/upload/v1/logo.png

# Cloudinary (archivos PDF)
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# CORS (orígenes permitidos, separados por coma)
CORS_ORIGINS=http://localhost:4321
